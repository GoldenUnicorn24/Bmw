# Copy to .env and NEVER commit .env or secrets. Use a dedicated low-balance hot wallet.
HOST=127.0.0.1
PORT=8787
API_BEARER_TOKEN=GENERATE_A_RANDOM_TOKEN_OF_AT_LEAST_32_CHARACTERS
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Live execution requires all three settings + a Jupiter key:
ENABLE_LIVE_TRADES=NO
SOLANA_PRIVATE_KEY_B58=
JUPITER_API_KEY=

# Signal engine is bundled. No third-party language-model key is required.

# Comma-separated, individually reviewed token mint addresses. Empty by default.
TRADING_ALLOWLIST=
MAX_TRADE_SOL=0.01
MAX_DAILY_SPEND_SOL=0.05
MIN_SOL_RESERVE=0.02
MAX_ORDERS_PER_DAY=3
MAX_SLIPPAGE_BPS=100

# Autonomous trades require opt-in, expire after max 24h and never auto-resume after server restart. Exit-only checks can continue 2h beyond expiry.
ALLOW_AUTONOMOUS_LIVE=NO
# One-time activation expires within 24 hours and does not resume automatically on restart.
AUTOPILOT_SESSION_HOURS=24
TRADE_LOG_PATH=./private/trades.json
STOP_FILE=./STOP

# Offline research report is never used to authorize blockchain trades.
RESEARCH_REPORT_PATH=
